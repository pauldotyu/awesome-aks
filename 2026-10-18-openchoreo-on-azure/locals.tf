locals {
  # A short random suffix keeps the disposable test environment unique.
  random_suffix = random_string.example.result

  rg_name        = "rg-openchoreo-${local.random_suffix}"
  aks_name       = "aks-openchoreo-${local.random_suffix}"
  key_vault_name = "kv-openchoreo-${local.random_suffix}"

  # OpenChoreo control-plane namespace.
  openchoreo_namespace = "openchoreo-control-plane"

  # --- Azure DNS zone resolution ------------------------------------------
  # The zone normally pre-exists (and may live in another subscription), so
  # everything downstream consumes these resolved values rather than the
  # resource directly.
  dns_zone_managed = var.create_dns_zone

  # The subscription that hosts the environment. Matches the default azurerm
  # provider's subscription.
  environment_subscription_id = (
    var.subscription_id != ""
    ? var.subscription_id
    : data.azurerm_client_config.current.subscription_id
  )

  # The subscription that holds the Azure DNS zone. Only the DNS role
  # assignment and the A records are ever written there.
  dns_zone_subscription_id = (
    var.dns_zone_subscription_id != ""
    ? var.dns_zone_subscription_id
    : local.environment_subscription_id
  )

  dns_zone_resource_group_name = (
    var.create_dns_zone
    ? azurerm_resource_group.example.name
    : var.dns_zone_resource_group_name
  )

  dns_zone_id = (
    var.create_dns_zone
    ? azurerm_dns_zone.example[0].id
    : data.azurerm_dns_zone.existing[0].id
  )

  dns_zone_name_servers = (
    var.create_dns_zone
    ? azurerm_dns_zone.example[0].name_servers
    : data.azurerm_dns_zone.existing[0].name_servers
  )

  # The kube_config generated by AKS is written to a local file that the
  # terraform_data local-exec steps (kubectl/helm) read. Matches the pattern in
  # 2023-10-19-build-ai-day-london/appconfig.tf.
  kubeconfig_filename = "aks-openchoreo.kubeconfig"

  # Entra tenant + v2 OIDC endpoints.
  tenant_id       = data.azurerm_client_config.current.tenant_id
  oidc_issuer     = "https://login.microsoftonline.com/${local.tenant_id}/v2.0"
  oidc_well_known = "${local.oidc_issuer}/.well-known/openid-configuration"
  oidc_jwks_url   = "https://login.microsoftonline.com/${local.tenant_id}/discovery/v2.0/keys"
  oidc_authorize  = "${local.oidc_issuer}/oauth2/v2.0/authorize"
  oidc_token      = "${local.oidc_issuer}/oauth2/v2.0/token"

  # OpenChoreo API application identifier uri. This is a static, readable app id
  # uri (NOT derived from the client_id, to avoid a self-dependency cycle).
  # It is the resource the scopes are expressed against.
  openchoreo_api_app_id_uri = "api://openchoreo-api"

  # Exact OAuth redirect URI Backstage posts to; must match the web.redirect_uris
  # declared on openchoreo-backstage and the auth.redirectUrls chart value.
  console_auth_redirect_uri = "https://${var.console_hostname}/api/auth/openchoreo-auth/handler/frame"

  # OIDC identity scopes requested during the Backstage sign-in flow.
  msgraph_openid_profile_email = [
    "openid",
    "profile",
    "email",
  ]

  # A DNS/label-safe slug of the platform-engineer group name, used to name the
  # ClusterAuthzRoleBinding the bootstrap mapping renders.
  platform_engineer_group_slug = lower(replace(var.platform_engineer_group_display_name, " ", "-"))

  # Context passed to files/control-plane-values.yaml.tpl. Kept here so the
  # generated values only reference resolved data (no interpolation surprises).
  openchoreo_values = {
    console_hostname = var.console_hostname
    api_hostname     = var.api_hostname

    console_auth_redirect_uri              = local.console_auth_redirect_uri
    openchoreo_api_app_id_uri              = local.openchoreo_api_app_id_uri
    openchoreo_api_client_id               = azuread_application.openchoreo_api.client_id
    openchoreo_backstage_client_id         = azuread_application.openchoreo_backstage.client_id
    openchoreo_backstage_service_client_id = azuread_application.openchoreo_backstage_service.client_id

    platform_engineer_group_object_id = data.azuread_group.platform_engineer.object_id
    platform_engineer_group_slug      = local.platform_engineer_group_slug
    namespace                         = local.openchoreo_namespace

    oidc_issuer     = local.oidc_issuer
    oidc_well_known = local.oidc_well_known
    oidc_jwks_url   = local.oidc_jwks_url
    oidc_authorize  = local.oidc_authorize
    oidc_token      = local.oidc_token
  }

  # The single Let's Encrypt ClusterIssuer that backs cp-gateway-tls. Both are
  # always created; switching letsencrypt_environment to "production" re-issues
  # the certificate from the production ACME server.
  selected_issuer = (
    var.letsencrypt_environment == "production"
    ? "letsencrypt-azure-dns-production"
    : "letsencrypt-azure-dns-staging"
  )

  # DNS names covered by the control-plane certificate. The two control-plane
  # names are required now; the remaining two are pre-provisioned on the same
  # zone so the data plane (*.apps) and an optional observability plane
  # (observer.obs) can reuse this certificate later without reissuing.
  cp_tls_dns_names = [
    var.console_hostname,
    var.api_hostname,
    "*.apps.aks.rocks",
    "observer.obs.aks.rocks",
  ]
}
