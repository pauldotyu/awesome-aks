# ---------------------------------------------------------------------------
# Azure Key Vault + External Secrets Operator identity
#
# The OpenChoreo control plane reads a native Kubernetes Secret named
# `backstage-secrets` (namespace openchoreo-control-plane). Rather than writing
# that secret from Terraform state, the four values live in this Azure Key Vault
# and are projected into the cluster by External Secrets Operator using the
# `external-secrets` Workload Identity below. This keeps the client secrets out
# of Terraform state (they stay in Entra + Key Vault) and is the Azure-native
# replacement for the OpenBao secret store in the upstream getting-started.
#
# The four Key Vault secrets map one-to-one to the backstage-secrets keys:
#   backstage-backend-secret          -> backend-secret
#   backstage-client-secret           -> client-secret
#   backstage-service-client-secret   -> service-client-secret
#   backstage-jenkins-api-key         -> jenkins-api-key
# ---------------------------------------------------------------------------

resource "azurerm_key_vault" "example" {
  name                       = local.key_vault_name
  location                   = azurerm_resource_group.example.location
  resource_group_name        = azurerm_resource_group.example.name
  tenant_id                  = data.azurerm_client_config.current.tenant_id
  tags                       = var.tags
  sku_name                   = "standard"
  rbac_authorization_enabled = true
  soft_delete_retention_days = 7
}

# Backend secret generated by Terraform (never stored in Entra).
resource "random_password" "backstage_backend_secret" {
  length  = 32
  lower   = true
  upper   = true
  numeric = true
  special = true
}

resource "azurerm_key_vault_secret" "backstage_backend_secret" {
  name         = "backstage-backend-secret"
  key_vault_id = azurerm_key_vault.example.id
  value        = random_password.backstage_backend_secret.result
}

# Entra browser-client secret.
resource "azurerm_key_vault_secret" "backstage_client_secret" {
  name         = "backstage-client-secret"
  key_vault_id = azurerm_key_vault.example.id
  value        = azuread_application_password.openchoreo_backstage.value

  depends_on = [
    azuread_application_password.openchoreo_backstage,
  ]
}

# Entra service-client secret.
resource "azurerm_key_vault_secret" "backstage_service_client_secret" {
  name         = "backstage-service-client-secret"
  key_vault_id = azurerm_key_vault.example.id
  value        = azuread_application_password.openchoreo_backstage_service.value

  depends_on = [
    azuread_application_password.openchoreo_backstage_service,
  ]
}

# OpenChoreo does not use Jenkins in this control-plane-only deployment.
resource "azurerm_key_vault_secret" "backstage_jenkins_api_key" {
  name         = "backstage-jenkins-api-key"
  key_vault_id = azurerm_key_vault.example.id
  value        = "not-used"
}

# ---------------------------------------------------------------------------
# External Secrets Operator Workload Identity
#
# ESO authenticates to Azure Key Vault through this user-assigned managed
# identity. The federated credential subject is the ESO controller service
# account, which the helm chart annotates with the client-id above and the AKS
# aad-pod-identity webhook labels/labels so the projected token is mounted.
# ---------------------------------------------------------------------------

resource "azurerm_user_assigned_identity" "external_secrets" {
  resource_group_name = azurerm_resource_group.example.name
  name                = "external-secrets"
  location            = azurerm_resource_group.example.location
}

# Least privilege: read-only access to secrets (and certificates) in the vault.
resource "azurerm_role_assignment" "external_secrets_kv" {
  principal_id                     = azurerm_user_assigned_identity.external_secrets.principal_id
  scope                            = azurerm_key_vault.example.id
  role_definition_name             = "Key Vault Secrets User"
  skip_service_principal_aad_check = true
}

resource "azurerm_federated_identity_credential" "external_secrets" {
  user_assigned_identity_id = azurerm_user_assigned_identity.external_secrets.id
  name                      = "external-secrets"
  issuer                    = azurerm_kubernetes_cluster.example.oidc_issuer_url
  audience                  = ["api://AzureADTokenExchange"]
  subject                   = "system:serviceaccount:external-secrets:external-secrets"
}
