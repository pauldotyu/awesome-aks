apiVersion: pkg.crossplane.io/v1beta1
kind: DeploymentRuntimeConfig
metadata:
  name: provider-opentofu
spec:
  serviceAccountTemplate:
    metadata:
      name: provider-opentofu
      annotations:
        azure.workload.identity/client-id: "${PROVISIONER_CLIENT_ID}"
        azure.workload.identity/tenant-id: "${AZURE_TENANT_ID}"
  deploymentTemplate:
    spec:
      selector: {}
      template:
        metadata:
          labels:
            azure.workload.identity/use: "true"
        spec:
          containers:
            - name: package-runtime
              args: ["--poll=5m", "--max-reconcile-rate=1", "--timeout=30m"]
              env:
                - name: ARM_USE_AKS_WORKLOAD_IDENTITY
                  value: "true"
                - name: ARM_USE_CLI
                  value: "false"
                - name: ARM_SUBSCRIPTION_ID
                  value: "${AZURE_SUBSCRIPTION_ID}"
                - name: ARM_TENANT_ID
                  value: "${AZURE_TENANT_ID}"
                - name: ARM_CLIENT_ID
                  value: "${PROVISIONER_CLIENT_ID}"
              resources:
                requests:
                  cpu: 500m
                  memory: 1Gi
                limits:
                  memory: 4Gi
---
apiVersion: pkg.crossplane.io/v1
kind: Provider
metadata:
  name: provider-opentofu
spec:
  package: xpkg.upbound.io/upbound/provider-opentofu:${PROVIDER_OPENTOFU_VERSION}
  runtimeConfigRef:
    name: provider-opentofu
