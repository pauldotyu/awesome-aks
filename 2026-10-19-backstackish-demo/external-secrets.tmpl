apiVersion: external-secrets.io/v1
kind: SecretStore
metadata:
  name: azure-keyvault
  namespace: backstage
spec:
  refreshInterval: 3600
  provider:
    azurekv:
      vaultUrl: ${KEY_VAULT_URL}
      authType: WorkloadIdentity
      tenantId: ${TENANT_ID}
---
apiVersion: external-secrets.io/v1
kind: ExternalSecret
metadata:
  name: backstage-secrets
  namespace: backstage
spec:
  refreshInterval: 1h
  secretStoreRef:
    kind: SecretStore
    name: azure-keyvault
  target:
    name: backstage-secrets
    creationPolicy: Owner
    template:
      type: Opaque
  data:
    - secretKey: AUTH_MICROSOFT_CLIENT_SECRET
      remoteRef:
        key: ${AUTH_MICROSOFT_CLIENT_SECRET}
    - secretKey: GITHUB_TOKEN
      remoteRef:
        key: ${GITHUB_TOKEN}